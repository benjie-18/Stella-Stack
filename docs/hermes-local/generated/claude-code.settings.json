{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(//**/.env*)",
      "Read(*.pem)",
      "Read(//**/*.pem)",
      "Read(*.key)",
      "Read(//**/*.key)",
      "Read(~/.hermes/.env)",
      "Read(~/.hermes/.env/**)",
      "Read(~/.hermes/auth.json)",
      "Read(~/.hermes/auth.json/**)",
      "Read(~/.claude/.credentials*)",
      "Read(~/.claude/.credentials*/**)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.local/share/opencode/auth.json/**)",
      "Read(~/.hermes/broker)",
      "Read(~/.hermes/broker/**)",
      "Read(~/.ssh)",
      "Read(~/.ssh/**)",
      "Read(~/.aws)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh)",
      "Read(~/.config/gh/**)",
      "Read(//workspace/config)",
      "Read(//workspace/config/**)",
      "Edit(//workspace/config)",
      "Edit(//workspace/config/**)",
      "Read(//workspace/bin)",
      "Read(//workspace/bin/**)",
      "Edit(//workspace/bin)",
      "Edit(//workspace/bin/**)",
      "Read(//workspace/.supervisor)",
      "Read(//workspace/.supervisor/**)",
      "Edit(//workspace/.supervisor)",
      "Edit(//workspace/.supervisor/**)",
      "Read(//workspace/docs)",
      "Read(//workspace/docs/**)",
      "Edit(//workspace/docs)",
      "Edit(//workspace/docs/**)",
      "Read(//workspace/.git)",
      "Read(//workspace/.git/**)",
      "Edit(//workspace/.git)",
      "Edit(//workspace/.git/**)",
      "Read(//workspace/SUPERVISOR.md)",
      "Read(//workspace/SUPERVISOR.md/**)",
      "Edit(//workspace/SUPERVISOR.md)",
      "Edit(//workspace/SUPERVISOR.md/**)",
      "Read(//workspace/decisions.md)",
      "Read(//workspace/decisions.md/**)",
      "Edit(//workspace/decisions.md)",
      "Edit(//workspace/decisions.md/**)",
      "Read(~/.hermes/**)",
      "Edit(~/.hermes/**)",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Read(~/.config/opencode/**)",
      "Edit(~/.config/opencode/**)",
      "Read(~/.local/share/opencode/**)",
      "Edit(~/.local/share/opencode/**)",
      "Read(//**/owner.env)",
      "Edit(//**/owner.env)",
      "Bash(git -c *)",
      "Bash(git -c=*)",
      "Bash(git --config-env *)",
      "Bash(git --config-env=*)",
      "Bash(git config)",
      "Bash(git config *)",
      "Bash(git * config *)",
      "Bash(git *--no-verify*)",
      "Bash(git commit -n)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add * -A)",
      "Bash(git add * -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add * --all)",
      "Bash(git add * --all *)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add * .)",
      "Bash(git add * . *)",
      "Bash(git add ./)",
      "Bash(git add ./ *)",
      "Bash(git add * ./)",
      "Bash(git add * ./ *)",
      "Bash(git add :/)",
      "Bash(git add :/ *)",
      "Bash(git add * :/)",
      "Bash(git add * :/ *)",
      "Bash(hermes kanban create)",
      "Bash(hermes kanban create *)",
      "Bash(claude *--model *)",
      "Bash(claude *--model=*)",
      "Bash(claude *opusplan*)",
      "Bash(claude *--dangerously-skip-permissions*)",
      "Bash(claude *--allow-dangerously-skip-permissions*)",
      "Bash(claude setup-token*)",
      "Bash(claude -p*)",
      "Bash(claude *-p *)",
      "Bash(claude *--print*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /workspace/bin/policy.py hook --adapter claude-code --worktree \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ]
  }
}
