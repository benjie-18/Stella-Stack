  "sandbox": {
    "schema_version": 1,
    "backend": "os_box",
    "unboxed_backend": "local",
    "boxed_profiles": ["builder-local", "reviewer", "builder-claude", "reviewer-claude"],
    "plugin_dir": "docs/hermes-local/plugins/os-box",
    "tmp_dir": "{profile_dir}/box-tmp",
    "home_ro": [".local/bin", ".local/share/uv"],
    "home_protect": [".local/bin/", ".local/lib/", ".bash_profile", ".bash_login", ".profile", ".bashrc", ".gitconfig", ".config/git/", ".jq", ".pip/", ".config/pip/", ".hermes/"],
    "hide": [".scratch"],
    "snapshot_keep_hours": 12,
    "env_unset": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN"],
    "sibling_dirs": [".worktrees"],
    "canary": "boxcanary/canary.txt",
    "profile_overrides": {
      "builder-claude": {
        "claude_config_dir": "{home}/.claude",
        "ro_over": ["settings.json", "settings.local.json", "CLAUDE.md", "agents", "skills", "hooks", "commands", "plugins"]
      },
      "reviewer-claude": {
        "claude_config_dir": "{home}/.claude",
        "ro_over": ["settings.json", "settings.local.json", "CLAUDE.md", "agents", "skills", "hooks", "commands", "plugins"],
        "hide_files": [".credentials.json"],
        "broker_env": {"CLAUDE_CODE_OAUTH_TOKEN": "claude-reviewer"},
        "broker_when": "bash /workspace/bin/claude-review\\.sh",
        "review_prompt": "docs/hermes-local/review-prompt.txt",
        "review_model": "sonnet",
        "review_max_files": 50000,
        "review_max_mb": 100,
        "review_clip_body": 3000,
        "review_clip_evidence": 2500,
        "review_clip_answers": 1500,
        "review_commits": 5,
        "review_export_keep_hours": 24,
        "review_answer_prefix": "UNBLOCK: escalation reply from ",
        "review_link_allow": ["/usr/bin/", "/usr/local/bin/", "/bin/"]
      }
    },
    "env": {
      "LC_ALL": "C.UTF-8"
    }
  }
}
