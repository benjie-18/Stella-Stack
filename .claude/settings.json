{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(npm run build *)"
    ],
    "deny": [
      "Skill(superpowers:brainstorming)",
      "Edit(//workspace/config/**)",
      "Write(//workspace/config/**)",
      "Bash(*owner.env*)",
      "Bash(*/.env*)",
      "Bash(* .env*)",
      "Bash(*.pem*)",
      "Bash(*/*.key*)",
      "Bash(*.hermes/auth.json*)",
      "Bash(*.claude/.credentials*)",
      "Bash(*opencode/auth.json*)",
      "Bash(*/.ssh/*)",
      "Bash(*~/.ssh*)",
      "Bash(*/.aws/*)",
      "Bash(*~/.aws*)",
      "Bash(*.config/gh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/post-edit-check.sh",
            "timeout": 120,
            "statusMessage": "Running tests and lint"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true
  }
}
