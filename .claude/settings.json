{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(npm run build *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/post-edit-check.sh",
            "timeout": 120,
            "statusMessage": "Running tests and lint"
          }
        ]
      }
    ]
  }
}
