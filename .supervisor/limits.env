# Limits for bin/escalate.sh (sourced; plain KEY=value, no secrets).
# Opus is allowed only for these purposes (space-separated).
OPUS_PURPOSES="plan rescue"
# Concurrent Opus calls (one lockfile slot each).
OPUS_MAX_CONCURRENT=1
# Haiku calls per UTC day (date-stamped counter under .supervisor/state/).
HAIKU_MAX_PER_DAY=40
# Per-call cap passed to claude --max-budget-usd, and wall-clock timeout in seconds.
MAX_BUDGET_USD=1
CALL_TIMEOUT=600
# Where POOL_EXHAUSTED and queue alerts go.
ALERT_TARGET="discord:#alerts"
# Queue for refused or pool-exhausted calls (bin/escalate-drain.sh, manual): at most this many queued entries, and an
# entry older than this many hours is stale (skipped by the drain).
QUEUE_MAX=50
QUEUE_MAX_AGE_HOURS=24
# Discord ids (#escalations, guild, #supervisor) live in config/owner.env (D39), loaded after this file: keep empty here.
ESCALATIONS_CHANNEL_ID=""
# K3: consecutive runs of one card, since its last unblock, refused by a guard with the same STL code before the stack
# blocks the card as needs_input (bin/kanban-guard.sh). Read by its own line, never sourced for it.
GUARD_REFUSAL_LOOP_N=3
