# Owner config (D39): who owns this stack and where it lives. Copy to config/owner.env (gitignored), fill in, then
# `chmod 555 config; chmod 444 config/owner.env` and run `bin/owner-config.sh --check` (offline) and `--verify` (read-only Discord).
# Grammar: KEY=value or KEY='value', one per line, # comments. Single quotes are literal (no escapes, no expansion).
# Ids and names only: never a token or secret here (the Discord bot token stays in Hermes's own secret store).
# These values are neutral placeholders; the self-tests use them as fixtures.
# Values may be KEY=value, KEY='value', or KEY="value". Double quotes are allowed only around a value containing no $, backtick, backslash, or "

# How agents name the owner in SOULs.
OWNER_NAME='owner'
# The owner's Discord user id: only this user's thread replies and 🔒/🗑️ reactions are applied. # Empty or malformed owner ID = nobody can unblock, until it is fixed (D72)
OWNER_DISCORD_USER_ID='100000000000000001'
# The stack folder on the Windows host; /workspace in the container is this same folder.
OWNER_STACK_PATH_WIN='C:\stack'
# GitHub user or org that owns the project repos.
GITHUB_OWNER='owner'
# Discord server (guild), #escalations and #supervisor channel ids.
DISCORD_GUILD_ID='100000000000000002'
ESCALATIONS_CHANNEL_ID='100000000000000003'
SUPERVISOR_CHANNEL_ID='100000000000000004'

# WORKER_GIT_NAME='worker'
# WORKER_GIT_EMAIL='worker@example.invalid'
