{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:9b-64k",
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        "qwen3.5:9b-64k": {
          "name": "Qwen 3.5 9B 64K",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "bin/escalate.sh *": "allow",
      "/workspace/bin/escalate.sh *": "allow",
      "claude *--model opus*": "deny",
      "claude *--model=opus*": "deny",
      "claude *--model haiku*": "deny",
      "claude *--model=haiku*": "deny",
      "claude *opusplan*": "deny",
      "claude *--dangerously-skip-permissions*": "deny",
      "claude *--allow-dangerously-skip-permissions*": "deny",
      "claude setup-token*": "deny",
      "claude *--model sonnet*": "deny",
      "claude *--model=sonnet*": "deny",
      "claude *--model claude-*": "deny",
      "claude *--model=claude-*": "deny",
      "claude -p*": "deny",
      "claude *-p *": "deny",
      "claude *--print*": "deny",
      "*owner.env*": "deny",
      "*/.env*": "deny",
      "* .env*": "deny",
      "*.pem*": "deny",
      "*/*.key*": "deny",
      "*.hermes/auth.json*": "deny",
      "*.claude/.credentials*": "deny",
      "*opencode/auth.json*": "deny",
      "*/.ssh/*": "deny",
      "*~/.ssh*": "deny",
      "*/.aws/*": "deny",
      "*~/.aws*": "deny",
      "*.config/gh*": "deny"
    },
    "edit": {
      "*owner.env*": "deny"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*/.hermes/auth.json": "deny",
      "*/.claude/.credentials*": "deny",
      "*/.local/share/opencode/auth.json": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.config/gh/*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow"
    },
    "skill": {
      "built-in-browser": "deny",
      "chrome-browser": "deny",
      "deep-research": "deny",
      "docs": "deny",
      "import-memory": "deny",
      "morning": "deny",
      "pptx": "deny",
      "setup-writing-style": "deny",
      "skill-creator": "deny",
      "brainstorming": "deny",
      "computer-use": "deny",
      "docx": "deny",
      "google-workspace": "deny",
      "pdf": "deny",
      "xlsx": "deny"
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#2ce8aa15d05bd57213e6f746f953aafb7ded7a8b"
  ]
}
