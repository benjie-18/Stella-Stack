{
  "schema_version": 1,
  "token": {
    "prefix": "stlrt_",
    "random_bytes": 32,
    "ttl_s": 43200,
    "max_ttl_s": 172800
  },
  "proxy": {
    "bind": "127.0.0.1",
    "port": 0,
    "max_body_bytes": 8388608,
    "forward_headers": [
      "accept",
      "anthropic-version",
      "anthropic-beta"
    ],
    "forward_query": [
      "alt"
    ]
  },
  "mcp": {
    "bind": "127.0.0.1",
    "port": 0,
    "path": "/mcp",
    "hosts": [
      "127.0.0.1",
      "localhost",
      "::1"
    ],
    "auth_header": "authorization",
    "auth_scheme": "Bearer",
    "max_body_bytes": 1048576,
    "timeout_s": 30,
    "protocol_versions": [
      "2025-06-18",
      "2025-03-26"
    ],
    "server_info": {
      "name": "stella-capabilities",
      "version": "1"
    }
  }
}
