{
  "schema_version": 1,
  "entries": [
    {
      "id": "stella-data",
      "kind": "command",
      "summary": "Check, list, get and search the contract data files (connections, role assignments, data policy, capabilities, features, versions, settings, extensions)",
      "keywords": [
        "data",
        "schema",
        "check",
        "catalog",
        "capability",
        "search",
        "contract",
        "x-ref",
        "x-ref-where",
        "x-owner-only",
        "global_id"
      ],
      "inputs": "a data id, an entry id or search words",
      "outputs": "JSON or text; exit 1 with a catalog code when a file is invalid or an id is unknown",
      "allowed_roles": [
        "dispatcher",
        "builder",
        "reviewer"
      ],
      "risk_class": "read",
      "hosts": [],
      "secrets": [],
      "status": "approved",
      "source": "bin/stella_data.py",
      "triage": {
        "result": "shipped"
      },
      "global_id": "54840665-3c5f-469a-8db0-0f269516ff0a",
      "install_id": "49bd8c3a-02ae-497f-aba3-5bd96c1e7df6"
    },
    {
      "id": "stella-data-ids-migrate",
      "kind": "command",
      "summary": "Write a candidate of one data file with global_id and install_id added to every record that lacks them, nothing else changed; apply it with stella-apply.py",
      "keywords": [
        "ids-migrate",
        "global_id",
        "install_id",
        "migration",
        "record"
      ],
      "inputs": "an index row id (<id>/<file>.json for a folder row) and --out <new file>",
      "outputs": "the candidate file; exit 1 with a catalog code when the row is unknown, --out lies inside the stack root, or the file cannot be written",
      "allowed_roles": [
        "dispatcher",
        "builder",
        "reviewer"
      ],
      "risk_class": "write",
      "hosts": [],
      "secrets": [],
      "status": "approved",
      "source": "bin/stella_data.py",
      "triage": {
        "result": "shipped"
      },
      "global_id": "a6246a2b-19c7-4b09-9976-a91299b42a95",
      "install_id": "49bd8c3a-02ae-497f-aba3-5bd96c1e7df6"
    },
