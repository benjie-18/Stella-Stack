    {
      "id": "stella-data",
      "kind": "command",
      "summary": "Check, list, get and search the contract data files (connections, role assignments, data policy, capabilities, features, versions, settings, extensions)",
      "keywords": [
        "data",
        "schema",
        "check",
        "catalog",
        "capability",
        "search",
        "contract"
      ],
      "inputs": "a data id, an entry id or search words",
      "outputs": "JSON or text; exit 1 with a catalog code when a file is invalid or an id is unknown",
      "allowed_roles": [
        "dispatcher",
        "builder",
        "reviewer"
      ],
      "risk_class": "read",
      "hosts": [],
      "secrets": [],
      "status": "approved",
      "source": "bin/stella_data.py",
      "triage": {
        "result": "shipped"
      }
    },
