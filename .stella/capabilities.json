    {
      "id": "apply",
      "kind": "command",
      "summary": "Apply or roll back a data file through the apply contract: dry run, backup, idempotent apply, one event line",
      "keywords": [
        "apply",
        "rollback",
        "backup",
        "dry-run",
        "settings"
      ],
      "inputs": "a data file id and a candidate file",
      "outputs": "the change summary; STL-CFG-312 for a worker on an owner-only file, STL-CFG-313 when the candidate is invalid",
      "allowed_roles": [],
      "risk_class": "write",
      "hosts": [],
      "secrets": [],
      "status": "approved",
      "source": "bin/stella-apply.py",
      "triage": {
