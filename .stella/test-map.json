{
  "schema_version": 1,
  "about": "Which selftests a changed file can affect (product rule 8). bin/test-map.py reads this: `check` is the lint (in npm test through bin/test-map-selftest.sh), `select` picks the targets. A file on the full list or matched by no row selects the full suite. `check` refuses a map whose rows leave out a selftest that can reach the file (see reach in bin/test-map.py); the error names what to add. `scan` rows are for selftests that read a whole folder. A row with no targets may match only prose: no code, executable, test-like file, or file a code or data file (`data`) names.",
  "runner": "bin/selftests.sh",
  "test_file": "bin/{name}-selftest.sh",
  "test_like": [
    "*test*",
    "*.spec.*",
    "*_spec.*"
  ],
  "not_tests": [
    "bin/selftests.sh",
    "bin/test-map.py",
    ".stella/test-map.json",
    ".stella/schemas/test-map.schema.json",
    "bench/tasks/*",
    "tests/fixtures/*",
    "docs/hermes-local/hooks/reviewer/test-only-terminal.sh",
    ".claude/agents/*.md"
  ],
  "follow": [
    "*.py",
    "*.sh",
    "*.ps1"
  ],
  "data": [
    "*.json",
    "*.yaml",
    "*.yml",
    "*.toml",
    "*.txt",
    "*.conf",
    "*.env",
    "*.ini",
    "*.js",
    "*.html",
    "*Dockerfile*"
  ],
  "always": [
    "hardcode-lint",
    "owner-leak",
    "stella-data",
    "test-map"
  ],
  "full": [
    "bin/selftests.sh",
    "bin/test-map.py",
    "bin/stella_data.py",
    "bin/stella-apply.py",
    "bin/event_log.py",
    "bin/settings.py",
    "bin/hardcode-lint-selftest.sh",
    "bin/hardcode-lint.sh",
    "*guard*",
    ".stella/*",
    "docs/hermes-local/*",
    ".devcontainer/*",
    "config/*",
    ".supervisor/*",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bunfig.toml",
    "opencode.json",
    ".pre-commit-config.yaml",
    "bin/roles.py",
    "bin/alert_catalog.py",
    "bin/alert.sh",
    "bin/alert-catalog.sh",
    "docs/alert-codes.md",
    "bin/kanban-board.sh",
    "bin/owner-config.sh",
    "bin/owner_config.py",
    "bin/apply-hermes-local.sh",
    "bin/register-*.sh",
    "bin/escalation-discord.sh",
    "bin/escalation-complete.sh",
    "bin/escalation-on-*.sh",
    "bin/escalation-thread.sh",
    "SUPERVISOR.md"
  ],
