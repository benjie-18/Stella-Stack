{
  "schema_version": 1,
  "link_classes": [
    {
      "id": "local",
      "privacy_rank": 0,
      "hosted": false
    },
    {
      "id": "frontier",
      "privacy_rank": 1,
      "hosted": true
    },
    {
      "id": "free_cloud",
      "privacy_rank": 2,
      "hosted": true
    }
  ],
  "class_defaults": {
    "local": "local",
    "aggregator": "free_cloud"
  },
  "task_tiers": [
    {
      "id": "light"
    },
    {
      "id": "medium"
    },
    {
      "id": "complex"
    }
  ],
  "drivers": [
    {
      "id": "engine_loop",
      "mid_task": true
    },
    {
      "id": "worker_cli",
      "mid_task": false
    }
  ],
  "effort": {
    "levels": ["low", "medium", "high", "max"],
    "by_role": {
      "dispatcher": "low",
      "router": "low",
      "voice": "low",
      "look": "low",
      "builder": {"default": "medium", "tiers": {"light": "low"}},
      "reviewer": "medium",
      "tester": "medium",
      "validator": "medium",
      "proposer": "high",
      "verifier": "high",
      "red-team": "high"
    }
  },
  "exempt_roles": [
    {
      "role": "router",
      "class_order": ["local"],
      "in_fallback_chain": true
    },
    {
      "role": "voice",
      "class_order": ["local"],
      "in_fallback_chain": false
    }
  ],
  "card_roles": ["builder", "reviewer", "tester", "validator", "verifier", "red-team"],
  "builder_roles": ["builder"],
  "cross_family": {"builder_role": "builder", "reviewer_roles": ["validator", "verifier"]},
  "escalation": {
    "purposes": {"judge": "validator", "review": "reviewer", "plan": "proposer", "rescue": "builder"}
  },
  "workflow": {
    "required_roles": [
      {
        "role": "tester",
        "when": "always"
      },
      {
        "role": "red-team",
        "when": "security"
      }
    ],
    "triggers": {
      "security": {
        "can_fire": true
      },
      "mismatch": {
        "can_fire": true
      },
      "fix_grew": {
        "can_fire": true
      },
      "owner_full": {
        "can_fire": true
      }
    }
  },
  "failover": {
    "triggers": {
      "rate_limit": {
        "cooldown_s": 60,
        "max_cooldown_s": 3600,
        "scope": "link"
      },
      "daily_cap": {
        "cooldown_s": 3600,
        "max_cooldown_s": 86400,
        "scope": "connection"
      },
      "timeout": {
        "cooldown_s": 120,
        "max_cooldown_s": 1800,
        "scope": "link"
      },
      "server_error": {
        "cooldown_s": 120,
        "max_cooldown_s": 1800,
        "scope": "link"
      },
      "malformed_tool_call": {
        "cooldown_s": 300,
        "max_cooldown_s": 3600,
        "scope": "link"
      },
      "model_gone": {
        "cooldown_s": 86400,
        "max_cooldown_s": 86400,
        "scope": "link"
      },
      "context_too_small": {
        "cooldown_s": 0,
        "max_cooldown_s": 0,
        "scope": "link"
      }
    },
    "same_connection_first": true,
    "max_switches_per_task": 8,
    "retry_count": 0
  },
  "consent": {
    "approval_class": "send",
    "ttl_s": 86400,
    "alert_code_queue": "STL-MDL-720",
    "alert_code_notice": "STL-MDL-729"
  },
  "card_facts": {
    "when_missing": {
      "carries_secrets": true,
      "vault_content": true
    }
  },
  "credentials": {
    "backend": "none",
    "backends": {
      "none": {
        "kind": "none"
      }
    }
  },
  "probe": {
    "lengths": [1000, 4000, 16000, 32000, 64000],
    "needles": 3,
    "hops": 2,
    "tolerance": 0.2,
    "output_shapes": ["strict_schema", "grammar", "json_mode", "none"],
    "shape_trials": 3,
    "repair_retries": 1
  },
  "triage": {
    "role": "router",
    "tiers": ["chat", "question", "work"],
    "image_route": "image",
    "project": {"default": "work", "keep": ["question"]},
    "threshold": 0.7,
    "samples": 3,
    "min_labels": 50
  }
}
