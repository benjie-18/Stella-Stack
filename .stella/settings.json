{
  "schema_version": 1,
  "entries": [
    {
      "key": "WORKER_GIT_NAME",
      "label": "Git author name for worker commits",
      "type": "string",
      "validation": {
        "pattern": "^[^\\n]{1,100}(?!\\n)$"
      },
      "scope": "global",
      "sensitivity": "identity_critical",
      "default": null,
      "store": {
        "data": "owner-settings",
        "key": "WORKER_GIT_NAME"
      },
      "apply": {
        "script": "bin/stella-apply.py",
        "needs_restart": false
      },
      "code": "STL-CFG-315",
      "global_id": "0913a5f5-5eb5-4071-94ec-af36401c48b4",
      "install_id": "49bd8c3a-02ae-497f-aba3-5bd96c1e7df6"
    },
    {
      "key": "WORKER_GIT_EMAIL",
      "label": "Git author email for worker commits",
      "type": "string",
      "validation": {
        "pattern": "^[^@\\s]+@[^@\\s]+(?!\\n)$"
      },
      "scope": "global",
      "sensitivity": "identity_critical",
      "default": null,
      "store": {
        "data": "owner-settings",
        "key": "WORKER_GIT_EMAIL"
      },
      "apply": {
        "script": "bin/stella-apply.py",
        "needs_restart": false
      },
      "code": "STL-CFG-315",
      "global_id": "0dd5be98-e0eb-4a01-b0ab-c7817fafa89e",
      "install_id": "49bd8c3a-02ae-497f-aba3-5bd96c1e7df6"
    },
    {
      "key": "CALL_TIMEOUT",
      "label": "Seconds before a Claude call is stopped",
      "type": "integer",
      "validation": {
        "minimum": 1,
        "maximum": 86400
      },
      "scope": "global",
      "sensitivity": "plain",
      "default": 600,
      "store": {
        "data": "limits",
        "key": "CALL_TIMEOUT"
      },
      "apply": {
        "script": "bin/stella-apply.py",
        "needs_restart": false
      },
      "code": "STL-CFG-315",
      "global_id": "aad50eee-9e5a-4760-8142-adf22251a227",
      "install_id": "49bd8c3a-02ae-497f-aba3-5bd96c1e7df6"
    },
    {
      "key": "QUEUE_MAX",
      "label": "Most held Claude requests kept in the queue",
      "type": "integer",
      "validation": {
        "minimum": 0,
        "maximum": 100000
      },
      "scope": "global",
      "sensitivity": "plain",
      "default": 50,
      "store": {
        "data": "limits",
        "key": "QUEUE_MAX"
      },
      "apply": {
        "script": "bin/stella-apply.py",
        "needs_restart": false
      },
      "code": "STL-CFG-315",
      "global_id": "32f40408-682b-4886-bae6-ebe3bf079b64",
      "install_id": "49bd8c3a-02ae-497f-aba3-5bd96c1e7df6"
    }
  ]
}
