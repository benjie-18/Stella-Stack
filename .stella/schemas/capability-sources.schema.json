{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability sources and search settings",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_folders": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$",
        "maxLength": 256
      }
    },
    "mcp_manifests": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$",
        "maxLength": 256
      }
    },
    "mcp_keys": {
      "description": "The keys of an MCP manifest (and of the CLI config files the adapters data names) that hold the declared servers.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "extension_folders": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$",
        "maxLength": 256
      }
    },
    "ranking": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "keywords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "summary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "id",
        "keywords",
        "summary"
      ],
      "additionalProperties": false
    },
    "default_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "request_ttl_s": {
      "type": "integer",
      "minimum": 60,
      "maximum": 2592000
    },
    "gated_risk_classes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "capability_prompt_line": {
      "type": "string",
      "maxLength": 1024
    },
    "semantic_ranking": {
      "type": "boolean"
    },
    "command_folders": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$",
        "maxLength": 256
      }
    },
    "command_globs": {
      "description": "Files matched by name are commands too; every file with the user x bit under the command folders (recursively, any extension) is one regardless. command_exclude is matched case-insensitively.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "command_exclude": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "toolset_entry": {
      "type": "object",
      "description": "How a role's own platform toolset appears as a search result for that role only (summary: {name} is the toolset name).",
      "properties": {
        "kind": {
          "enum": [
            "tool",
            "skill",
            "mcp_server",
            "command",
            "extension"
          ]
        },
        "risk_class": {
          "enum": [
            "read",
            "write",
            "post",
            "send",
            "pay",
            "delete",
            "sign_in",
            "host_session",
            "input_source"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "risk_class",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "skill_folders",
    "mcp_manifests",
    "mcp_keys",
    "extension_folders",
    "ranking",
    "default_limit",
    "request_ttl_s",
    "gated_risk_classes",
    "capability_prompt_line",
    "semantic_ranking",
    "command_folders",
    "command_globs",
    "command_exclude",
    "toolset_entry"
  ],
  "additionalProperties": false
}
