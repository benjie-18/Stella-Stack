{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Primary lease",
  "description": "The primary-lease contract (F1c B6, design D5): exactly one engine per account holds it. lease_id is the lease's global id. U1 builds the real lease service; bin/lease_double.py is its test double.",
  "type": "object",
  "properties": {
    "account": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "engine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "install_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "acquired_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "required": ["account", "engine_id", "install_id", "lease_id", "acquired_at", "expires_at"],
  "additionalProperties": false
}
