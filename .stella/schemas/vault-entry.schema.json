{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault entry (rotating credential)",
  "description": "Metadata of one rotating credential. Schema only: the secret itself is never a field here (additionalProperties is false); it stays in the broker.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "global_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "install_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "kind": {
      "description": "A lower-case name for the kind of credential. B1 defines the kinds; this field becomes an x-ref to them then.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "last_refreshed": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "custody": {
      "enum": [
        "engine_store",
        "vm_run"
      ]
    },
    "lease": {
      "type": [
        "object",
        "null"
      ],
      "description": "null: nobody holds it. One holder field, so there is never more than one live holder.",
      "properties": {
        "holder": {
          "type": "string",
          "pattern": "^(engine|vm_run:[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"
        },
        "acquired_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "required": [
        "holder",
        "acquired_at",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "write_back": {
      "type": "object",
      "properties": {
        "rule": {
          "const": "compare_and_swap"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "rule",
        "expected_version"
      ],
      "additionalProperties": false
    },
    "sync_class": {
      "type": "string",
      "x-ref": "data-policy/sync_classes",
      "x-ref-where": {
        "cloud": false
      },
      "description": "A sync class of the data policy whose cloud is false: a vault entry never reaches a cloud store."
    }
  },
  "required": [
    "schema_version",
    "global_id",
    "install_id",
    "kind",
    "version",
    "last_refreshed",
    "custody",
    "lease",
    "write_back",
    "sync_class"
  ],
  "additionalProperties": false
}
