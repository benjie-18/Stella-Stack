{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval decision",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "decided_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "decision": {
      "enum": [
        "approved",
        "denied",
        "expired"
      ]
    },
    "decided_by": {
      "type": "object",
      "properties": {
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "channel",
        "user"
      ],
      "additionalProperties": false
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "decided_at",
    "decision",
    "decided_by",
    "note"
  ],
  "additionalProperties": false
}
