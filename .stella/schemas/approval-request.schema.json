{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "requested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "requester": {
      "type": "object",
      "properties": {
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "role",
        "channel",
        "user"
      ],
      "additionalProperties": false
    },
    "approval_class": {
      "enum": [
        "read",
        "write",
        "post",
        "send",
        "pay",
        "delete",
        "sign_in"
      ]
    },
    "action": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "card": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "requested_at",
    "requester",
    "approval_class",
    "action",
    "summary"
  ],
  "additionalProperties": false
}
