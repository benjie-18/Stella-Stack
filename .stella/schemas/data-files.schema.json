{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data file index",
  "x-one-document": true,
  "x-record-kind-of": {
    "data-policy": "project"
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_log": {
      "type": "string",
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "backup_dir": {
      "type": "string",
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "applied_state": {
      "type": "string",
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "role_table": {
      "type": "string",
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$"
          },
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "format": {
            "enum": [
              "json",
              "env"
            ]
          },
          "owner_only": {
            "type": "boolean"
          },
          "redact_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "list_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "id_field": {
            "type": "string"
          },
          "record_kind": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$",
            "description": "The kind of the row's records: a key of data-policy record_kinds, which gives their sync class. A row with records (a list_key, or a folder row) must name one. x-record-kind-of pins it for the rows of a schema (the data policy's records are projects: a relabel would move the default and every project onto another kind's sync class)."
          },
          "global_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "The record's global id: a lower-case version 4 UUID, unique across every data file (product rule 14). The record's old id stays its alias: every read that takes an entry id accepts either."
          },
          "install_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "The UUID of the install that made the record (its .stella/install.json); a record moved from another install keeps it."
          }
        },
        "required": [
          "id",
          "path",
          "schema",
          "format",
          "owner_only",
          "redact_keys",
          "list_key",
          "id_field"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "event_log",
    "backup_dir",
    "applied_state",
    "role_table",
    "files"
  ],
  "additionalProperties": false
}
