{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host presence",
  "description": "The host's facts about the owner's current host request (F3 B11, DC-10): its route, the paired device and its biometric, the on-screen indicator, the kill switch, each input source's own indicator, and whether the request is final. Written on the host only (index key host_presence, under the protected .supervisor tree); bin/host_access.py decide reads it and never trusts a request for these facts. A missing record refuses.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "route": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "device": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "biometric": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "biometric"
      ],
      "additionalProperties": false
    },
    "presence": {
      "type": "object",
      "properties": {
        "indicator": {
          "type": "boolean"
        },
        "kill_switch": {
          "type": "boolean"
        },
        "input_indicators": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Capability id of an input source -> its own indicator is on."
        }
      },
      "required": [
        "indicator",
        "kill_switch"
      ],
      "additionalProperties": false
    },
    "final": {
      "type": "object",
      "description": "submitted: a typed or device command was submitted; closed: a spoken turn ended; open: not yet.",
      "properties": {
        "state": {
          "enum": [
            "submitted",
            "closed",
            "open"
          ]
        },
        "turn": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "detector": {
              "enum": [
                "semantic",
                "release",
                "silence"
              ],
              "description": "What ended the turn: the semantic turn detector, a push-to-talk release, or a silence timeout alone (never final)."
            },
            "reopened_within_grace": {
              "type": "boolean"
            }
          },
          "required": [
            "detector",
            "reopened_within_grace"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "global_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "install_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schema_version",
    "route",
    "presence",
    "global_id",
    "install_id"
  ],
  "additionalProperties": false
}
