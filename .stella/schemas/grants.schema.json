{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability grants",
  "description": "The capabilities the owner has granted (F1c B3). Owner-only and identity-critical: only the owner path writes it, with the typed confirmation phrase. Ships empty.",
  "x-one-document": true,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "description": "The capability id (.stella/capabilities.json)."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "description": "The role, profile or project the grant is for."
          },
          "approved_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "expires_at": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "global_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "The record's global id: a lower-case version 4 UUID, unique across every data file (product rule 14)."
          },
          "install_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "The UUID of the install that made the record (its .stella/install.json)."
          }
        },
        "required": ["capability", "to", "approved_at", "expires_at", "global_id", "install_id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "grants"],
  "additionalProperties": false
}
