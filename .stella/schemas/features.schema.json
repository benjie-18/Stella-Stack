{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature registry",
  "x-one-document": true,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "owner_phase": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "off",
              "preview",
              "on"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]*$"
            }
          },
          "flag": {
            "type": [
              "string",
              "null"
            ]
          },
          "global_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "The record's global id: a lower-case version 4 UUID, unique across every data file (product rule 14). The record's old id stays its alias: every read that takes an entry id accepts either."
          },
          "install_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "The UUID of the install that made the record (its .stella/install.json); a record moved from another install keeps it."
          }
        },
        "required": [
          "id",
          "owner_phase",
          "status",
          "depends_on",
          "flag"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "entries"
  ],
  "additionalProperties": false
}
