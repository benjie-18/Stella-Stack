{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature registry",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "owner_phase": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "off",
              "preview",
              "on"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]*$"
            }
          },
          "flag": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "owner_phase",
          "status",
          "depends_on",
          "flag"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "entries"
  ],
  "additionalProperties": false
}
