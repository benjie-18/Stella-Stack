{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark results",
  "description": "One trial of one task for one role on one link (index key benchmark_results), written on the host by the benchmark. Protected state, not a data file. bin/compare.py reads only the valid records of this install and ignores the rest; a file it cannot read is no record (the advertised score stands).",
  "x-one-document": true,
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "records": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "install_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "role": {"type": "string", "minLength": 1, "maxLength": 128},
          "connection": {"type": "string", "minLength": 1, "maxLength": 128},
          "model": {"type": "string", "minLength": 1, "maxLength": 256},
          "task": {"type": "string", "minLength": 1, "maxLength": 256},
          "trial": {"type": "integer", "minimum": 0, "maximum": 100000},
          "passed": {"type": "boolean"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "cost": {"type": "number", "minimum": 0, "description": "Cost of the trial, in the pricing table's currency (optional)."},
          "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "suite_version": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "required": ["install_id", "role", "connection", "model", "task", "trial", "passed", "score", "ts", "suite_version"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "records"],
  "additionalProperties": false
}
