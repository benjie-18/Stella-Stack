{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved hosts",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "pattern": "^(\\*\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+|[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*)$",
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        },
        "required": [
          "host",
          "port",
          "scope",
          "approved_by",
          "approved_at",
          "expires_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "hosts"
  ],
  "additionalProperties": false
}
