{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved hosts",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "scope": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "host",
          "port",
          "scope",
          "approved_by",
          "approved_at",
          "expires_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "hosts"
  ],
  "additionalProperties": false
}
