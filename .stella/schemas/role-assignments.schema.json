{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role assignments",
  "x-one-document": true,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "effort_modes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "allowed_localities": {
            "type": "array",
            "items": {
              "enum": [
                "local",
                "cloud"
              ]
            },
            "minItems": 1
          },
          "no_silent_fallback": {
            "type": "boolean"
          }
        },
        "required": [
          "allowed_localities",
          "no_silent_fallback"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "scope": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "global",
                  "project",
                  "card"
                ]
              },
              "project": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]*$"
              },
              "card": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "level"
            ],
            "additionalProperties": false
          },
          "role": {
            "type": "string"
          },
          "effort_mode": {
            "type": "string"
          },
          "chain": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._:-]*$"
                },
                "model": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object"
                }
              },
              "required": [
                "provider",
                "model",
                "parameters"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "global_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "The record's global id: a lower-case version 4 UUID, unique across every data file (product rule 14). The record's old id stays its alias: every read that takes an entry id accepts either."
          },
          "install_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "The UUID of the install that made the record (its .stella/install.json); a record moved from another install keeps it."
          }
        },
        "required": [
          "id",
          "scope",
          "role",
          "effort_mode",
          "chain"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "effort_modes",
    "assignments"
  ],
  "additionalProperties": false
}
