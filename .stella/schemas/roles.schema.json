{
  "type": "object",
  "required": ["schema_version", "fallback_role", "protected", "owner_settings", "profiles", "roles"],
  "properties": {
    "schema_version": {"enum": [1]},
    "fallback_role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "protected": {"type": "object", "required": ["repo", "home"], "properties": {"repo": {"$ref": "#/$defs/paths"}, "home": {"$ref": "#/$defs/paths"}}},
    "owner_settings": {"$ref": "#/$defs/paths"},
    "self_config_kinds": {"type": "array", "items": {"type": "string"}},
    "profiles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/profile"}},
    "roles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/role"}},
    "sandbox": {"type": "object", "required": ["schema_version"], "properties": {"schema_version": {"enum": [1]}}}
  },
  "$defs": {
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "profile": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "dir": {"type": "string"},
        "soul": {"type": "string"},
        "worker": {"type": "string"},
        "display_name": {"type": "string"}
      }
    },
    "requirements": {
      "type": "object",
      "required": ["tool_calling", "min_context_tokens", "vision", "allowed_data_classes"],
      "additionalProperties": false,
      "properties": {
        "tool_calling": {"type": "boolean"},
        "min_context_tokens": {"type": "integer", "minimum": 0},
        "vision": {"type": "boolean"},
        "allowed_data_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}}
      }
    },
    "role": {
      "type": "object",
      "required": ["requirements", "assignable", "workspace", "may_complete", "may_unblock", "may_claim", "may_delegate",
                   "may_create_cards", "may_review", "allowed_overrides"],
      "properties": {
        "requirements": {"$ref": "#/$defs/requirements"},
        "assignable": {"type": "boolean"},
        "workspace": {"enum": ["git-worktree", "read-parent-worktree", "none"]},
        "may_complete": {"type": "boolean"},
        "may_unblock": {"type": "boolean"},
        "may_claim": {"type": "boolean"},
        "may_delegate": {"type": "boolean"},
        "may_create_cards": {"type": "boolean"},
        "may_review": {"type": "boolean"},
        "allowed_overrides": {"type": "array", "uniqueItems": true, "items": {"enum": ["model", "provider"]}},
        "background_review": {"type": "boolean"},
        "workers": {"type": "array", "items": {"type": "string"}},
        "hooks": {"type": "array", "items": {"type": "object", "required": ["matcher"], "properties": {"matcher": {"type": "string"}}}}
      }
    }
  }
}
