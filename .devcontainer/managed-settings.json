{
  "permissions": {
    "deny": [
      "Read(//workspace/.env)",
      "Read(//workspace/.env.*)",
      "Read(//workspace/**/.env)",
      "Read(//workspace/**/.env.*)",
      "Read(~/.hermes/.env)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(*/.env*)",
      "Bash(* .env*)",
      "Bash(*\".env*)",
      "Bash(*'.env*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
